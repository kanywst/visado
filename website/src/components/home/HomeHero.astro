---
import { Icon } from '@astrojs/starlight/components';
import { url } from './url';

// The eight scenarios in deploy/lab/demo.sh, in the order the script runs them.
// Keep in sync with deploy/lab/README.md.
const scenarios = [
  { what: 'No credentials', code: 401, verdict: 'denied' },
  { what: 'Encoded / in the path', code: 400, verdict: 'rejected by Envoy' },
  { what: 'agent-a reads tickets for bob', code: 200, verdict: 'allowed' },
  { what: "agent-b forwards bob's transaction to the admin API", code: 403, verdict: 'denied by the PDP' },
  { what: "agent-b forwards bob's transaction to tickets", code: 200, verdict: 'allowed' },
  { what: 'A workload outside internal_callers forwards it', code: 403, verdict: 'denied' },
  { what: 'User token without roles.write on the admin API', code: 403, verdict: 'denied by the PDP' },
  { what: 'carol, with roles.write, through agent-a', code: 200, verdict: 'allowed' },
];
---

<div class="status" role="note">
  <p>
    <strong>Pre-alpha (v0.1.0).</strong> Not for production. Wire formats will change.{' '}
    <a href={url('/roadmap/')}>See the roadmap</a>
  </p>
</div>

<section class="hero not-content" aria-labelledby="hero-title">
  <div class="pitch">
    <h1 id="hero-title">
      <span>WIMSE credentials in.</span>
      <span>AuthZEN decides.</span>
      <span>Transaction Token out.</span>
    </h1>
    <p class="sub">
      visado is an ext_authz service for Envoy, Istio and agentgateway. For each request it
      verifies the caller's workload credential or OAuth access token, asks an OpenID AuthZEN 1.0
      policy decision point, denies on any error, and sends a signed Transaction Token downstream
      in place of the caller's credentials. Written in Rust, licensed Apache-2.0.
    </p>
    <div class="actions">
      <a class="btn primary" href={url('/getting-started/')}>Run the lab</a>
      <a class="btn secondary" href={url('/spec-map/')}>Read the spec map</a>
      <a class="gh" href="https://github.com/kanywst/visado">
        <Icon name="github" size="1.15em" />
        <span>kanywst/visado</span>
      </a>
    </div>
  </div>

  <figure class="ledger" aria-labelledby="ledger-cap">
    <figcaption id="ledger-cap">
      <span>What the lab checks</span>
      <code>deploy/lab/demo.sh</code>
    </figcaption>
    <ol>
      {
        scenarios.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="what">{s.what}</span>
            <span class:list={['stamp', s.code === 200 ? 'allow' : 'deny']}>
              <b>{s.code}</b>
              <span class="verdict">{s.verdict}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="note">Envoy, visado, OPA with the AuthZEN plugin and an echo upstream. CI runs all eight.</p>
  </figure>
</section>

<style>
  .status {
    margin: -0.5rem 0 2.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 4px solid var(--v-stamp);
    border-radius: 6px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .status p {
    margin: 0;
  }
  .status a {
    color: var(--sl-color-accent-high);
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-bottom: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 1.2rem + 1.9vw, 2.7rem);
    line-height: 1.06;
    font-weight: 640;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }
  h1 span {
    display: block;
  }

  .sub {
    margin: 1.5rem 0 0;
    max-width: 36rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.15rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.2;
    border: 1.5px solid var(--sl-color-accent);
  }
  .btn.primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  :global([data-theme='light']) .btn.primary {
    color: #fff;
  }
  .btn.primary:hover {
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }
  .btn.secondary {
    color: var(--sl-color-white);
  }
  .btn.secondary:hover {
    background: var(--sl-color-accent-low);
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    padding: 0.4rem 0.2rem;
  }
  .gh:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The ledger: the lab's own outcomes, stamped. */
  .ledger {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--v-panel);
    padding: 1.1rem 1.25rem 1rem;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  figcaption code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
    align-self: center;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--v-rule);
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }
  li::before {
    content: counter(step);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
  }
  li:last-child {
    border-bottom: 0;
  }
  .what {
    color: var(--sl-color-gray-1);
  }

  .stamp {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.12rem 0.45rem;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    transform: rotate(-2deg);
  }
  li:nth-child(even) .stamp {
    transform: rotate(1.5deg);
  }
  .stamp b {
    font-weight: 500;
    font-size: 0.95rem;
  }
  .stamp.allow {
    color: var(--v-allow-ink);
    border-color: var(--v-allow);
  }
  .stamp.deny {
    color: var(--v-deny-ink);
    border-color: var(--v-deny);
  }

  .note {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /* One load moment: the stamps land in the order the demo runs. */
  @media (prefers-reduced-motion: no-preference) {
    .stamp {
      animation: land 360ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
      animation-delay: calc(250ms + var(--i) * 110ms);
    }
    li:nth-child(even) .stamp {
      animation-name: land-even;
    }
  }
  @keyframes land {
    from {
      opacity: 0;
      transform: scale(1.35) rotate(-6deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(-2deg);
    }
  }
  @keyframes land-even {
    from {
      opacity: 0;
      transform: scale(1.35) rotate(5deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(1.5deg);
    }
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1.1rem minmax(0, 1fr);
    }
    .stamp {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
